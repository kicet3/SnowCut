# 하위 경로에 올릴 때 (GitHub Pages 등)
# NEXT_PUBLIC_BASE_PATH=/SnowCut

# 구글 애드센스 (없으면 광고를 그리지 않음)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_MIDDLE=
# NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# 커스텀 캐릭터 누끼 서버 (Background-Remover). 없으면 누끼 기능을 끈다.
# NEXT_PUBLIC_BG_REMOVER_URL=http://localhost:5000
# server.mjs 프록시를 쓸 때: 빌드는 NEXT_PUBLIC_BG_REMOVER_URL=/bg-remover, 실행은 BG_REMOVER_URL=http://127.0.0.1:5000

# 커스텀 캐릭터 기능 (기본 꺼짐: "준비중인 기능입니다." 표시)
# NEXT_PUBLIC_ENABLE_CHARACTER=1

# SEO: 정식 사이트 주소 · 검색엔진 소유 확인
# NEXT_PUBLIC_SITE_URL=https://snowcut.vercel.app
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
